DATABASE_URL="file:./dev.db"
DATA_MODE=mock
DISCOVERY_LIMIT=50000

KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=
KALSHI_PRIVATE_KEY_PEM=
POLYMARKET_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
AI_MATCHING_ENABLED=true
AI_MATCHING_MIN_BASELINE_SCORE=0.45
AI_MATCHING_MAX_PAIRS_PER_RUN=4
AI_MATCHING_CONCURRENCY=1

MIN_NET_EDGE_CENTS=0.25
MIN_SIZE=10
MAX_STALENESS_MS=10000
INCLUDE_REVIEW_PAIRS=false
TRADING_ENABLED=false

SLIPPAGE_BUFFER_CENTS=0.15
STALE_DATA_BUFFER_CENTS=0.10
FUNDING_BUFFER_CENTS=0.05
SCAN_QUANTITY=25
